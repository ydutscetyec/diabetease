# Copy to .env and fill in. Never commit the filled-in file.

# --- database -------------------------------------------------------------
# SQLite is the default and is sufficient for this project. Switch to Postgres
# by setting a postgresql+psycopg:// URL; no code change is needed.
DATABASE_URL=sqlite:///./diabetease.db

# --- admin access ---------------------------------------------------------
# Admin endpoints stay disabled until all three are set.
# Generate the hash:  python -c "from app.security import hash_password; print(hash_password('your-password'))"
SECRET_KEY=replace-with-64-random-hex-chars
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# --- API behaviour --------------------------------------------------------
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=60
SERVE_FRONTEND=true
DIABETEASE_BUILD=0.2.0-prototype

# --- privacy --------------------------------------------------------------
# Assessments are discarded unless this is true AND the respondent consents.
# Only enable with ethics clearance.
STORE_ASSESSMENTS=false
ASSESSMENT_RETENTION_DAYS=90

# --- model ----------------------------------------------------------------
MODEL_PATH=./ml/artifacts/model.joblib

# --- optional: language model for the chatbot -----------------------------
# Leave empty. The chatbot runs on the reviewed FAQ corpus when this is unset.
# A paid key is NOT required for any feature.
LLM_API_KEY=

# --- optional: grounded language model for Candie --------------------------
# All three must be set, or Candie serves the reviewed corpus text directly.
# The model may ONLY rephrase a retrieved corpus entry; it is never asked to
# answer from its own knowledge, and emergency/refusal checks run before it.
# Any OpenAI-compatible endpoint works, including a local one.
# Candie answers medical questions outside the reviewed corpus using the
# connected model. ON by default in this build. Set to false to restrict her to
# reviewed topics. Dosing, diagnosis and emergency handling are unaffected.
CLINICAL_OPEN_ANSWERS=true

LLM_BASE_URL=
LLM_MODEL=
